            .hero-art { min-height: 320px; padding: 15px; border-radius: 22px; }
            .art-copy { padding: 16px; }
            .art-copy strong { font-size: 18px; }
            .values, .commit-cards { grid-template-columns: 1fr; }
            .service-grid { grid-template-columns: 1fr; }
            .service { min-height: 0; }
            .product-grid { grid-template-columns: 1fr; }
            .contact-box { border-radius: 21px; }
        }
