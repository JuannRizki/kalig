            .topbar { padding-block: 14px; }
            nav { gap: 12px; }
            nav a:not(.nav-cta) { display: none; }
            .nav-cta { padding: 11px 14px; font-size: 11px !important; }
            .brand-name { font-size: 11px; }
            .brand-sub { font-size: 8px; }
            .hero { grid-template-columns: 1fr; gap: 35px; padding-block: 42px 60px; }
            .hero-art { min-height: 360px; }
            section.content, .contact { padding-block: 60px; }
            .section-grid, .commit-grid, .contact-box { grid-template-columns: 1fr; gap: 30px; }
            .services-head { align-items: start; flex-direction: column; }
            .service-grid { grid-template-columns: repeat(2, 1fr); }
            .footer-inner { align-items: start; flex-direction: column; }
            .product-grid { gap: 14px; }
        }

        @media (max-width: 480px) {
            .wrap { width: calc(100% - 28px); }
            .brand { gap: 8px; }
            .brand-mark { width: 38px; height: 38px; }
            .nav-cta { padding: 10px 12px; }
