        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body { margin: 0; background: var(--paper); color: var(--ink); }
        a { color: inherit; }
        .wrap { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
        .topbar { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 20px; }
        .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; }
        .brand-mark { display: grid; width: 44px; height: 44px; place-items: center; border-radius: 13px; background: var(--green); font-size: 17px; font-weight: 900; letter-spacing: -2px; }
        .brand-name { display: block; font-size: 13px; font-weight: 800; letter-spacing: .04em; }
        .brand-sub { display: block; margin-top: 4px; color: var(--muted); font-size: 9px; letter-spacing: .2em; text-transform: uppercase; }
        nav { display: flex; align-items: center; gap: 28px; }
        nav a { color: #46534b; font-size: 13px; font-weight: 600; text-decoration: none; }
        nav a:hover, .text-link:hover { color: #628e30; }
        .nav-cta { padding: 12px 18px; border-radius: 99px; background: var(--ink); color: white; }
        .hero { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 48px; padding-block: 52px 88px; }
        .eyebrow { display: inline-flex; align-items: center; gap: 9px; padding: 9px 14px; border: 1px solid #d9ded3; border-radius: 99px; background: #ffffff9c; color: #52644f; font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }
        .eyebrow:before { width: 7px; height: 7px; border-radius: 50%; background: #84b942; content: ""; }
        h1 { margin: 24px 0 0; font-size: clamp(52px, 7vw, 88px); line-height: .98; letter-spacing: -.075em; }
        h1 em { color: #6e963e; font-family: Georgia, serif; font-weight: 400; }
        .intro { max-width: 590px; margin: 24px 0 0; color: #59635d; font-size: 17px; line-height: 1.8; }
        .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
        .button { display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 48px; padding: 0 20px; border: 1px solid transparent; border-radius: 99px; font-size: 13px; font-weight: 700; text-decoration: none; transition: .2s ease; }
        .button-primary { background: var(--green); }
        .button-primary:hover { background: #b2df5d; transform: translateY(-1px); }
        .button-outline { border-color: #cfd4cc; }
        .button-outline:hover { border-color: #8b9b84; }
        .facts { display: flex; flex-wrap: wrap; gap: 38px; margin-top: 38px; padding-top: 20px; border-top: 1px solid #d9ddd5; }
        .fact strong, .fact span { display: block; }
        .fact strong { font-size: 18px; }
        .fact span { margin-top: 5px; color: #707a73; font-size: 11px; }
        .hero-art { position: relative; display: flex; min-height: 470px; align-items: flex-end; overflow: hidden; padding: 25px; border-radius: 30px; background: radial-gradient(ellipse at 70% 20%, #7d995e 0, transparent 38%), linear-gradient(140deg, #536a55 0%, #23382d 55%, #17251e 100%); box-shadow: 0 35px 75px -42px #1b2d22a6; }
        .hero-art:before, .hero-art:after { position: absolute; content: ""; }
        .hero-art:before { inset: 12% 9% 27%; border: 1px solid #ffffff25; border-radius: 50%; transform: rotate(-24deg); box-shadow: 0 0 0 22px #ffffff08, 0 0 0 54px #ffffff06; }
        .hero-art:after { top: 16%; right: 18%; width: 42%; height: 46%; border: 1px solid #d2e6b866; border-radius: 48% 48% 8% 8%; background: linear-gradient(120deg, #c4f06a20, #ffffff08); transform: skewY(-8deg); }
        .art-label { position: absolute; z-index: 1; top: 22px; left: 22px; padding: 10px 14px; border: 1px solid #ffffff38; border-radius: 99px; background: #14231b66; color: white; font-size: 11px; backdrop-filter: blur(8px); }
        .art-label:before { display: inline-block; width: 7px; height: 7px; margin-right: 8px; border-radius: 50%; background: var(--green); content: ""; }
        .art-copy { position: relative; z-index: 1; width: 100%; padding: 20px; border: 1px solid #ffffff32; border-radius: 18px; background: #18271fa8; color: white; backdrop-filter: blur(10px); }
        .art-copy span { color: var(--green); font-size: 10px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
        .art-copy strong { display: block; max-width: 370px; margin-top: 10px; font-size: 21px; line-height: 1.35; }
        section.content { padding-block: 82px; }
        .about { background: white; }
        .section-grid { display: grid; grid-template-columns: .72fr 1.28fr; gap: 76px; }
        .section-tag { color: #6e963e; font-size: 11px; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; }
        h2 { margin: 15px 0 0; font-size: clamp(34px, 4vw, 52px); line-height: 1.08; letter-spacing: -.055em; }
        .section-copy { margin: 0; color: #4f5b53; font-size: 17px; line-height: 1.85; }
        .section-copy + .section-copy { margin-top: 15px; color: #707a73; font-size: 14px; }
        .values { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 27px; padding-top: 24px; border-top: 1px solid #e5e8e2; }
        .values strong { font-size: 13px; }
        .values p { margin: 8px 0 0; color: #707a73; font-size: 13px; line-height: 1.7; }
        .services-head { display: flex; align-items: end; justify-content: space-between; gap: 26px; }
        .services-head p { max-width: 360px; margin: 0; color: #69746c; font-size: 13px; line-height: 1.7; }
        .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 36px; }
        .service { min-height: 175px; padding: 22px; border: 1px solid #e0e3db; border-radius: 17px; background: #fbfbf8; transition: .2s ease; }
        .service:hover { transform: translateY(-3px); border-color: #bdcf9e; background: white; box-shadow: 0 15px 40px -30px #1c352d73; }
