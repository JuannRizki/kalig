        .contact-box .button-outline { border-color: #789d47; }
        .contact-details { padding: 26px; border-radius: 18px; background: #ffffff8c; }
        .contact-details h3 { margin: 0 0 12px; color: #5b743d; font-size: 10px; letter-spacing: .18em; text-transform: uppercase; }
        .contact-details a { display: block; margin-top: 7px; font-size: 15px; font-weight: 700; text-decoration: none; }
        .contact-details a.email { font-size: 13px; font-weight: 500; overflow-wrap: anywhere; }
        .address-title { margin-top: 24px !important; }
        .contact-details address { margin-top: 10px; color: #4d5b48; font-size: 12px; font-style: normal; line-height: 1.7; }
        .contact-details address + address { margin-top: 8px; }
        footer { border-top: 1px solid var(--line); }
